# Copia este archivo como .env y rellena SOLO lo que vayas a usar. Nunca lo subas a git.

# --- Guiones automáticos (elige uno) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Voz premium (opcional; por defecto se usa Kokoro local gratis) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=

# --- Fondos generados por IA (opcional) ---
REPLICATE_API_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
